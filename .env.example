# Optional environment configuration for Google Drive Backup Downloader.
# Copy to .env and load it yourself, or set these in your shell / system
# environment. Everything here is optional - the app works with a plain
# credentials.json file and no environment variables at all.

# --- OAuth client -----------------------------------------------------------
# Alternative to shipping credentials.json. Use ONE of the two approaches.
# Create a "Desktop app" OAuth client in the Google Cloud Console first.
# GDBD_CLIENT_ID=1234567890-abcdefghijklmnop.apps.googleusercontent.com
# GDBD_CLIENT_SECRET=GOCSPX-your-client-secret

# Explicit path to a downloaded credentials.json (takes priority over the
# default search locations).
# GDBD_CREDENTIALS_FILE=C:\Users\you\secrets\credentials.json

# --- Storage ----------------------------------------------------------------
# Where the SQLite database, settings and logs live.
# Defaults to %LOCALAPPDATA%\GDriveBackup on Windows.
# GDBD_DATA_DIR=D:\GDriveBackupData
